{
  "name": "lakefront-capital-development",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@lakefront/web",
    "dev:api": "npm run dev --workspace=@lakefront/api",
    "build:shared": "npm run typecheck --workspace=@lakefront/content-model && npm run typecheck --workspace=@lakefront/contracts",
    "build": "npm run build:shared && npm run build --workspace=@lakefront/api && npm run build --workspace=@lakefront/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
